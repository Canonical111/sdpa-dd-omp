# macOS duplicate copies of the built binary ("sdpa_dd 2", "sdpa_dd 3", ...)
sdpa_dd [0-9]*

# OS and editor noise -- never track these. A tracked .DS_Store was found in the
# dd fork and removed; these rules exist so it cannot come back in any of them.
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
__MACOSX/
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# decompressed test inputs (CI and local runs produce these from the tracked .xz)
SDPLIB/data/*.dat-s

# generated by tests/gen_spchol_fixture.py -- built on demand, never committed
spchol_fix.dat-s
# generated by tests/gen_crossblock_fixture.py and tests/gen_f2dense_fixture.py, likewise
xb.dat-s
f2d.dat-s

# macOS/configure leaves numbered copies behind when configure is re-run in place
Makefile [0-9]*
